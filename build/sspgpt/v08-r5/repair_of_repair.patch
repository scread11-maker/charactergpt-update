+func TestOwnedChildHealthMissDoesNotCreateTerminationAuthority(t *testing.T) {
+	address := unusedAddress(t)
+	dir := t.TempDir()
+	path := filepath.Join(dir, "SSPGPTBridge.exe")
+	copyExecutable(t, path)
+	startFile := filepath.Join(dir, "starts.txt")
+	t.Setenv("SSPGPT_TEST_HELPER", "1")
+	t.Setenv("SSPGPT_TEST_HELPER_ADDR", address)
+	t.Setenv("SSPGPT_TEST_HELPER_SERVICE", "SSPGPTBridge")
+	t.Setenv("SSPGPT_TEST_HELPER_START_FILE", startFile)
+	t.Setenv("SSPGPT_TEST_HELPER_UNHEALTHY_AFTER_MS", "500")
+	child := Child{Name: "bridge", Path: path, Health: "http://" + address + "/health", Args: []string{"-test.run=TestSupervisorHelperProcess"}}
+	var supervisor Supervisor
+	if err := supervisor.StartAll(context.Background(), []Child{child}, dir); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, 5*time.Second, func() bool {
+		b, _ := os.ReadFile(startFile)
+		return strings.Count(string(b), "start") == 1 && ready(child)
+	}, "child never reached initial ready state")
+
+	// Wait longer than the former three-health-miss recycle window. The owned
+	// process remains alive, so Runtime must degrade/observe rather than kill it.
+	time.Sleep(7 * time.Second)
+	b, _ := os.ReadFile(startFile)
+	if got := strings.Count(string(b), "start"); got != 1 {
+		t.Fatalf("health misses caused an owned child recycle: starts=%d", got)
+	}
+	cmd, _ := supervisor.managed[0].process()
+	if cmd == nil || cmd.ProcessState != nil {
+		t.Fatal("owned child did not remain under its original process ownership")
+	}
+	if err := supervisor.Stop(); err != nil {
+		t.Fatal(err)
+	}
+}
