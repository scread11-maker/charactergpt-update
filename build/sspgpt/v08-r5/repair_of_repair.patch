+++ b/internal/runtime/host_action_plan_metadata_test.go
@@ -0,0 +1,38 @@
+package runtime
+
+import (
+	"testing"
+	"time"
+
+	"sspgpt/v08/internal/abi"
+)
+
+func TestRegisterHostPlanPreservesCanonicalStepTimingMetadata(t *testing.T) {
+	deadline := time.Date(2026, 8, 23, 8, 0, 0, 0, time.UTC)
+	service := &Service{plannedHostActions: map[string]plannedHostAction{}}
+	plan := abi.HostActionPlan{
+		PlanID:              "plan-1",
+		CausedByRequestID:   "request-1",
+		CausationID:         "cause-1",
+		HostContextRevision: 7,
+		Steps: []abi.HostActionPlanStep{{
+			ActionID:             "action-1",
+			CapabilityID:         "capability-1",
+			TypedParameters:      map[string]any{"target": "muna"},
+			StartRelationOrDelay: map[string]any{"relation": "after_presentation", "delay_ms": float64(250)},
+			Deadline:             deadline,
+		}},
+	}
+
+	service.registerHostPlan(plan)
+	got, ok := service.plannedHostActions["action-1"]
+	if !ok {
+		t.Fatal("registered HostActionPlan step was not retained")
+	}
+	if got.StartRelationOrDelay == nil {
+		t.Fatal("start_relation_or_delay was discarded")
+	}
+	if !got.Deadline.Equal(deadline) {
+		t.Fatalf("deadline=%v want=%v", got.Deadline, deadline)
+	}
+}
