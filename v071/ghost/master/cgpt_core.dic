// CharacterGPT v0.7.1 YAYA presentation / SSP adapter.
// UTF-8 throughout. Runtime remains authoritative for NOW and affect.
// YAYA owns presentation, direct SSP UI/input, and local timers only.

CGPT.Init
{
    // Persistent user setting.
    if ! ISVAR('CGPT.BalloonTimeoutMs') {
        CGPT.BalloonTimeoutMs = 15000
    }

    // Per-session presentation state.
    CGPT.RuntimeConnected = 0
    CGPT.ChatGPTLinkEnabled = 0
    CGPT.LinkedBusy = 0
    CGPT.LinkedReactionHold = 0
    CGPT.RecentReactionGuard = 0
    CGPT.AffectMode = 'neutral'
    CGPT.AffectPositive = 0.0
    CGPT.AffectShy = 0.0
    CGPT.AffectWary = 0.0
    CGPT.AffectAnnoyed = 0.0
    CGPT.AffectDowncast = 0.0
    CGPT.AffectPrimary = 'neutral'
    CGPT.AffectRevision = 0

    CGPT.RestoreGeneration = 0
    CGPT.RestoreExpectedGeneration = -1
    CGPT.RestorePendingGeneration = -1
    CGPT.RestorePendingKind = 0

    CGPT.IdleGeneration = 0
    CGPT.IdleActive = 0
    CGPT.IdleExpectedGeneration = -1
    CGPT.IdlePendingGeneration = -1
    CGPT.IdlePendingKind = 0

    CGPT.DressupSnapshotReady = 0
    CGPT.TouchInit
}

CGPT.HasBalloon
{
    // SSP Status exposes a visible balloon as balloon(scope=id/...).
    // YAYA receives that header in the global status variable.
    if 'balloon(' _in_ status {
        1
        return
    }
    0
}

CGPT.ControlHead
{
    // In YAYA the Satori "script head" equivalent is simply returning
    // \C as the first SakuraScript token. It preserves the current balloon.
    if CGPT.HasBalloon() {
        '\C'
        return
    }
    ''
}

CGPT.PreserveBalloonScript
{
    _script = _argv[0]
    if CGPT.HasBalloon() {
        '\C' + _script
        return
    }
    _script
}

CGPT.IsPresentationBusy
{
    if CGPT.LinkedBusy == 1 {
        1
        return
    }
    if CGPT.LinkedReactionHold == 1 {
        1
        return
    }
    if 'talking' _in_ status {
        1
        return
    }
    if 'choosing' _in_ status {
        1
        return
    }
    if 'timecritical' _in_ status {
        1
        return
    }
    if CGPT.HasBalloon() {
        1
        return
    }
    0
}

CGPT.ArmIdle
{
    CGPT.IdleGeneration += 1
    CGPT.IdleActive = 0
    CGPT.IdleExpectedGeneration = -1
    CGPT.IdlePendingGeneration = -1
    CGPT.IdlePendingKind = 0
    "\![timerraise,180000,1,OnCharacterGPTIdleReading,%(CGPT.IdleGeneration)]"
}

CGPT.CancelRestore
{
    CGPT.RestoreGeneration += 1
    CGPT.RestoreExpectedGeneration = -1
    CGPT.RestorePendingGeneration = -1
    CGPT.RestorePendingKind = 0
    ''
}

CGPT.ActivityScript
{
    CGPT.BookClickLatched = 0
    CGPT.BookLocalActive = 0
    CGPT.IdleActive = 0
    CGPT.RecentReactionGuard = 1
    _script = CGPT.ArmIdle
    _script += "\![timerraise,2000,1,OnCharacterGPTRecentReactionGuardEnd]"
    _script
}

CGPT.AffectValue
{
    _name = _argv[0]
    if _name == 'positive' {
        CGPT.AffectPositive
        return
    }
    if _name == 'shy' {
        CGPT.AffectShy
        return
    }
    if _name == 'wary' {
        CGPT.AffectWary
        return
    }
    if _name == 'annoyed' {
        CGPT.AffectAnnoyed
        return
    }
    if _name == 'downcast' {
        CGPT.AffectDowncast
        return
    }
    0.0
}

// Runtime Primary is the only challenger. Neutral entry >= .75; current mood
// holds >= .50; cross-mode change requires challenger >= .80 and +.10 margin.
CGPT.SelectMood
{
    _mode = CGPT.AffectMode
    _primary = CGPT.AffectPrimary
    _pv = CGPT.AffectValue(_primary)
    _cv = CGPT.AffectValue(_mode)

    if _mode == 'neutral' {
        if _primary != 'neutral' && _pv >= 0.75 {
            _primary
            return
        }
        'neutral'
        return
    }

    if _primary != 'neutral' && _primary != _mode {
        if _pv >= 0.80 && _pv >= (_cv + 0.10) {
            _primary
            return
        }
    }

    if _cv >= 0.50 {
        _mode
        return
    }
    'neutral'
}

CGPT.MoodSurface
{
    _kind = _argv[0]
    _mood = _argv[1]
    if _kind == 'idle' {
        if _mood == 'positive' {
            5
            return
        }
        if _mood == 'shy' {
            1
            return
        }
        if _mood == 'wary' {
            3
            return
        }
        if _mood == 'annoyed' {
            7
            return
        }
        if _mood == 'downcast' {
            4
            return
        }
        0
        return
    }
    if _mood == 'positive' {
        25
        return
    }
    if _mood == 'shy' {
        21
        return
    }
    if _mood == 'wary' {
        23
        return
    }
    if _mood == 'annoyed' {
        27
        return
    }
    if _mood == 'downcast' {
        4
        return
    }
    20
}

CGPT.ApplyMood
{
    _kind = _argv[0]
    _mood = _argv[1]
    CGPT.AffectMode = _mood
    _head = CGPT.ControlHead()

    // Connection staging owns visibility while Runtime is unavailable.
    // Automatic affect/idle restore must never reveal the main persona before
    // the authoritative Runtime websocket has opened. Keep Owl visible instead.
    if CGPT.RuntimeConnected != 1 {
        "%(_head)\0\s[-1]\1\s[10]\e"
        return
    }

    _surface = CGPT.MoodSurface(_kind,_mood)
    // Defensive preserve: if a balloon became visible between the guard and
    // this apply event, \C remains the true first token and the surface
    // change cannot clear the user's visible dialogue.
    "%(_head)\0\s[%(_surface)]\1\s[10]\e"
}

CGPT.BootScript
{
    CGPT.Init
    CGPT.RuntimeConnected = 0
    // Explicit SSP scopes: hide the main persona (scope 0) while local
    // services are starting, and show Owl (scope 1 / surface 10) as the
    // connection-stage presenter. Text following \1 is spoken by Owl.
    "\0\s[-1]\1\s[10]CharacterGPT v0.7.1 / YAYA：正在啟動本地服務與角色摘要……\n\![open,file,memory/CharacterGPTMemoryService.exe]\![open,file,bridge/CharacterGPTBridge.exe]\![open,file,touch/CharacterGPTTouchProgress.exe]\![open,file,runtime/CharacterGPTRuntime.exe]\_w[1800]\![execute,websocket,ws://127.0.0.1:8766,--async=OnCharacterGPT]\e"
}

OnFirstBoot
{
    CGPT.BootScript
}

OnBoot
{
    CGPT.BootScript
}

OnGhostChanged
{
    CGPT.BootScript
}

OnCharacterGPTOpen
{
    CGPT.RuntimeConnected = 1
    CGPT.ContactBoundaryPending = 1
    CGPT.TouchActive = 0
    CGPT.IdleActive = 0
    _idle = CGPT.ArmIdle
    _dress = ''
    if CGPT.DressupSnapshotReady == 1 {
        _dress = CGPT.DressupSnapshotPost
    }
    // Runtime websocket open is the reveal boundary. Explicitly show both
    // scopes, then return to scope 0 so the success balloon belongs to Mona.
    "\![send,websocket,ws://127.0.0.1:8766,SYSTEM|BOOT]\![execute,http-post,http://127.0.0.1:8770/state/shell-info,--nodescript,--nofile=UTF-8,--param=name=%(CGPT.ShellName),--param=path=%(CGPT.ShellPath),--timeout=2]%(_dress)%(_idle)\0\s[25]\1\s[10]\0\![set,balloontimeout,%(CGPT.BalloonTimeoutMs)]CharacterGPT Runtime 已連線。\n左鍵點非觸摸區域可開啟 CharacterGPT 選單。\e"
}

OnCharacterGPTReconnect
{
    CGPT.RuntimeConnected = 1
    CGPT.ContactBoundaryPending = 1
    CGPT.TouchActive = 0
    _idle = CGPT.ArmIdle
    _dress = ''
    if CGPT.DressupSnapshotReady == 1 {
        _dress = CGPT.DressupSnapshotPost
    }
    "\![open,file,touch/CharacterGPTTouchProgress.exe]\![execute,http-post,http://127.0.0.1:8770/state/shell-info,--nodescript,--nofile=UTF-8,--param=name=%(CGPT.ShellName),--param=path=%(CGPT.ShellPath),--timeout=2]%(_dress)%(_idle)\0\s[25]\1\s[10]\0\![set,balloontimeout,%(CGPT.BalloonTimeoutMs)]CharacterGPT Runtime 已重新連線。\e"
}

OnCharacterGPTFailure
{
    CGPT.RuntimeConnected = 0
    CGPT.BustClickLatched = 0
    // Failure remains in the connection-stage presenter: Mona hidden, Owl
    // visible, and the balloon belongs to scope 1.
    "\0\s[-1]\1\s[10]\![set,balloontimeout,0]CharacterGPT Runtime 尚未連線。\n\q[重新連線,OnStartCharacterGPTBridge]\e"
}

OnCharacterGPTClose
{
    CGPT.RuntimeConnected = 0
    CGPT.BustClickLatched = 0
    // A lost Runtime means the main persona is no longer cognitively online.
    // Return to Owl-only staging until a reconnect callback succeeds.
    "\0\s[-1]\1\s[10]\![set,balloontimeout,%(CGPT.BalloonTimeoutMs)]CharacterGPT Runtime 已中斷。\e"
}

OnStartCharacterGPTBridge
{
    CGPT.RuntimeConnected = 0
    "\0\s[-1]\1\s[10]正在重新連線……\n\![open,file,memory/CharacterGPTMemoryService.exe]\![open,file,bridge/CharacterGPTBridge.exe]\![open,file,touch/CharacterGPTTouchProgress.exe]\![open,file,runtime/CharacterGPTRuntime.exe]\_w[1800]\![execute,websocket,ws://127.0.0.1:8766,--async=OnCharacterGPT]\e"
}

OnNotifyShellInfo
{
    CGPT.ShellName = reference[0]
    CGPT.ShellPath = reference[1]
    ''
}

OnShellChanged
{
    CGPT.ShellName = reference[0]
    CGPT.ShellPath = reference[2]
    CGPT.DressupSnapshotReady = 0
    "\![execute,http-post,http://127.0.0.1:8770/state/shell-changed,--nodescript,--nofile=UTF-8,--param=name=%(reference[0]),--param=path=%(reference[2]),--timeout=2]"
}

OnNotifyDressupInfo
{
    CGPT.DressupRaw0 = reference[0]
    CGPT.DressupRaw1 = reference[1]
    CGPT.DressupRaw2 = reference[2]
    CGPT.DressupRaw3 = reference[3]
    CGPT.DressupRaw4 = reference[4]
    CGPT.DressupRaw5 = reference[5]
    CGPT.DressupRaw6 = reference[6]
    CGPT.DressupRaw7 = reference[7]
    CGPT.DressupRaw8 = reference[8]
    CGPT.DressupRaw9 = reference[9]
    CGPT.DressupRaw10 = reference[10]
    CGPT.DressupRaw11 = reference[11]
    CGPT.DressupRaw12 = reference[12]
    CGPT.DressupRaw13 = reference[13]
    CGPT.DressupRaw14 = reference[14]
    CGPT.DressupRaw15 = reference[15]
    // A full snapshot is authoritative only when SSP has just supplied it.
    // Keep it replayable for initial Runtime connect, but any later delta
    // invalidates that replay permission.
    CGPT.DressupSnapshotReady = 1
    CGPT.DressupSnapshotPost
}

CGPT.DressupSnapshotPost
{
    "\![execute,http-post,http://127.0.0.1:8770/state/dressup-info,--nodescript,--nofile=UTF-8,--param=raw0=%(CGPT.DressupRaw0),--param=raw1=%(CGPT.DressupRaw1),--param=raw2=%(CGPT.DressupRaw2),--param=raw3=%(CGPT.DressupRaw3),--param=raw4=%(CGPT.DressupRaw4),--param=raw5=%(CGPT.DressupRaw5),--param=raw6=%(CGPT.DressupRaw6),--param=raw7=%(CGPT.DressupRaw7),--param=raw8=%(CGPT.DressupRaw8),--param=raw9=%(CGPT.DressupRaw9),--param=raw10=%(CGPT.DressupRaw10),--param=raw11=%(CGPT.DressupRaw11),--param=raw12=%(CGPT.DressupRaw12),--param=raw13=%(CGPT.DressupRaw13),--param=raw14=%(CGPT.DressupRaw14),--param=raw15=%(CGPT.DressupRaw15),--timeout=2]"
}

OnDressupChanged
{
    // Delta is the newest appearance truth. Never replay an older cached
    // OnNotifyDressupInfo snapshot after this point.
    CGPT.DressupSnapshotReady = 0
    "\![execute,http-post,http://127.0.0.1:8770/state/dressup-changed,--nodescript,--nofile=UTF-8,--param=character_id=%(reference[0]),--param=part=%(reference[1]),--param=enabled=%(reference[2]),--param=category=%(reference[3]),--param=source=%(reference[4]),--timeout=2]"
}

OnCharacterGPTAppearanceSync
{
    if CGPT.DressupSnapshotReady == 1 {
        CGPT.DressupSnapshotPost
        return
    }
    ''
}

OnCharacterGPTAppearanceSyncFailure
{
    ''
}

CGPT.MenuPrompt
{
    {
        '有什麼事嗎？'
        '需要做什麼？'
        '選單開啟。'
    }
}

OnCharacterGPTMenu
{
    if TOINT(reference[3]) == 1 && TOINT(reference[5]) == 0 {
        OnOpenChat
        return
    }
    CGPT.BustClickLatched = 0
    CGPT.IdleActive = 0
    _idle = CGPT.ArmIdle
    _cancel = CGPT.CancelRestore
    _prompt = CGPT.MenuPrompt
    "%(_idle)\0\s[20]\![set,balloontimeout,0]\![set,choicetimeout,0]%(_prompt)\n\n\q[開始對話,OnOpenChat]\n\q[對話維持時間,OnBalloonDurationMenu]\n\q[ChatGPT連動,OnCharacterGPTLinkMenu]\n\q[設定 API Key,OnConfigureAPIKey]\n\n\q[關閉,OnCharacterGPTMenuClose]\e"
}

OnCharacterGPTMenuClose
{
    CGPT.BustClickLatched = 0
    CGPT.RestoreGeneration += 1
    "\0\b[-1]\![timerraise,15000,1,OnCharacterGPTSurfaceRestore,%(CGPT.RestoreGeneration)]\e"
}


// Optional Web ChatGPT / MCP link. Plug never starts during Ghost boot.
OnCharacterGPTLinkMenu
{
    CGPT.IdleActive = 0
    _idle = CGPT.ArmIdle
    _cancel = CGPT.CancelRestore
    if CGPT.ChatGPTLinkEnabled == 1 {
        "%(_idle)\0\s[20]\![set,balloontimeout,0]\![set,choicetimeout,0]ChatGPT連動\n狀態：已啟動／等待 Web ChatGPT\n\n\q[關閉連動,OnDisableChatGPTConnection]\n\q[重新連線,OnReconnectChatGPTConnection]\n\q[設定連線,OnConfigureChatGPTConnection]\n\q[返回,OnCharacterGPTMenu]\e"
        return
    }
    "%(_idle)\0\s[20]\![set,balloontimeout,0]\![set,choicetimeout,0]ChatGPT連動\n狀態：未啟動\n\n\q[開啟連動,OnEnableChatGPTConnection]\n\q[設定連線,OnConfigureChatGPTConnection]\n\q[返回,OnCharacterGPTMenu]\e"
}

OnEnableChatGPTConnection
{
    CGPT.ChatGPTLinkEnabled = 1
    "\![open,file,Plug/CharacterGPTContextService.exe]\0\s[25]\![set,balloontimeout,2400]ChatGPT連動已啟動。\n正在等待 Web ChatGPT 連線。\e"
}

OnDisableChatGPTConnection
{
    CGPT.ChatGPTLinkEnabled = 0
    CGPT.LinkedBusy = 0
    "\![execute,http-post,http://127.0.0.1:8782/shutdown,--nodescript,--nofile=UTF-8,--timeout=1]\0\s[25]\![set,balloontimeout,2200]ChatGPT連動已關閉。\e"
}

OnReconnectChatGPTConnection
{
    CGPT.ChatGPTLinkEnabled = 1
    "\![execute,http-post,http://127.0.0.1:8782/shutdown,--nodescript,--nofile=UTF-8,--timeout=1]\![timerraise,900,1,OnStartChatGPTConnection]\0\s[20]正在重新啟動 ChatGPT連動……\e"
}

OnStartChatGPTConnection
{
    "\![open,file,Plug/CharacterGPTContextService.exe]"
}

OnConfigureChatGPTConnection
{
    "\![open,file,Plug/CharacterGPTTunnelSetup.exe]\0\s[20]已開啟 ChatGPT連線設定。\n完成後重新啟動連動即可套用。\e"
}

OnBalloonDurationMenu
{
    CGPT.IdleActive = 0
    _idle = CGPT.ArmIdle
    _cancel = CGPT.CancelRestore
    "%(_idle)\0\s[20]\![set,balloontimeout,0]\![set,choicetimeout,0]對話維持時間\n\n\q[10 秒,OnSetBalloon10]\n\q[15 秒（標準）,OnSetBalloon15]\n\q[20 秒,OnSetBalloon20]\n\q[30 秒,OnSetBalloon30]\n\q[60 秒,OnSetBalloon60]\n\q[不自動關閉,OnSetBalloonManual]\n\q[返回,OnCharacterGPTMenu]\e"
}

CGPT.SetBalloon
{
    _sec = TOINT(_argv[0])
    CGPT.BalloonTimeoutMs = _sec * 1000
    if _sec == 0 {
        CGPT.BalloonTimeoutMs = 0
    }
    "\![send,websocket,ws://127.0.0.1:8766,CONFIG|BALLOON|%(_sec)]"
}
OnSetBalloon10
{
    CGPT.SetBalloon(10)
}
OnSetBalloon15
{
    CGPT.SetBalloon(15)
}
OnSetBalloon20
{
    CGPT.SetBalloon(20)
}
OnSetBalloon30
{
    CGPT.SetBalloon(30)
}
OnSetBalloon60
{
    CGPT.SetBalloon(60)
}
OnSetBalloonManual
{
    CGPT.SetBalloon(0)
}

CGPT.ArmRestore
{
    CGPT.RestoreGeneration += 1
    CGPT.RestoreExpectedGeneration = -1
    CGPT.RestorePendingGeneration = -1
    CGPT.RestorePendingKind = 0
    "\![timerraise,15000,1,OnCharacterGPTSurfaceRestore,%(CGPT.RestoreGeneration)]"
}

OnCharacterGPTBalloonTimeout
{
    CGPT.BustClickLatched = 0
    CGPT.LinkedReactionHold = 0
    _restore = CGPT.ArmRestore
    "\0\b[-1]\1\b[-1]%(_restore)\e"
}
OnBalloonClose
{
    CGPT.BustClickLatched = 0
    CGPT.LinkedReactionHold = 0
    CGPT.ArmRestore
}
OnBalloonTimeout
{
    CGPT.BustClickLatched = 0
    CGPT.LinkedReactionHold = 0
    CGPT.ArmRestore
}

OnCharacterGPTSurfaceRestore
{
    _gen = TOINT(reference[0])
    if _gen != CGPT.RestoreGeneration {
        ''
        return
    }
    if CGPT.IdleActive == 1 {
        ''
        return
    }
    if CGPT.IsPresentationBusy() {
        CGPT.PreserveBalloonScript("\![timerraise,400,1,OnCharacterGPTSurfaceRestore,%(_gen)]")
        return
    }
    CGPT.RestoreExpectedGeneration = _gen
    CGPT.RestorePendingGeneration = -1
    CGPT.RestorePendingKind = 0
    CGPT.PreserveBalloonScript("\![timerraise,650,1,OnCharacterGPTAffectRestoreFallback,%(_gen)]\![send,websocket,ws://127.0.0.1:8766,QUERY|AFFECT|restore]")
}

OnCharacterGPTAffectSnapshot
{
    CGPT.AffectPositive = TOREAL(reference[1])
    CGPT.AffectShy = TOREAL(reference[2])
    CGPT.AffectWary = TOREAL(reference[3])
    CGPT.AffectAnnoyed = TOREAL(reference[4])
    CGPT.AffectDowncast = TOREAL(reference[5])
    CGPT.AffectRevision = TOINT(reference[6])
    CGPT.AffectPrimary = reference[7]

    if reference[0] == 'restore' && CGPT.RestoreExpectedGeneration == CGPT.RestoreGeneration {
        _gen = CGPT.RestoreGeneration
        CGPT.RestoreExpectedGeneration = -1
        CGPT.RestorePendingGeneration = _gen
        CGPT.RestorePendingKind = 1
        CGPT.PreserveBalloonScript("\![timerraise,100,1,OnCharacterGPTAffectRestoreApply,%(_gen)]")
        return
    }

    if reference[0] == 'idle' && CGPT.IdleExpectedGeneration == CGPT.IdleGeneration && CGPT.IdleActive == 1 {
        _gen = CGPT.IdleGeneration
        CGPT.IdleExpectedGeneration = -1
        CGPT.IdlePendingGeneration = _gen
        CGPT.IdlePendingKind = 1
        CGPT.PreserveBalloonScript("\![timerraise,100,1,OnCharacterGPTAffectIdleApply,%(_gen)]")
        return
    }
    ''
}

OnCharacterGPTAffectRestoreFallback
{
    _gen = TOINT(reference[0])
    if _gen != CGPT.RestoreGeneration {
        ''
        return
    }
    if CGPT.RestoreExpectedGeneration != _gen {
        ''
        return
    }
    CGPT.RestoreExpectedGeneration = -1
    CGPT.RestorePendingGeneration = _gen
    CGPT.RestorePendingKind = 2
    CGPT.PreserveBalloonScript("\![timerraise,100,1,OnCharacterGPTAffectRestoreApply,%(_gen)]")
}

OnCharacterGPTAffectRestoreApply
{
    _gen = TOINT(reference[0])
    if _gen != CGPT.RestoreGeneration {
        ''
        return
    }
    if CGPT.RestorePendingGeneration != _gen {
        ''
        return
    }
    if CGPT.IdleActive == 1 {
        ''
        return
    }
    if CGPT.IsPresentationBusy() {
        CGPT.PreserveBalloonScript("\![timerraise,400,1,OnCharacterGPTAffectRestoreApply,%(_gen)]")
        return
    }
    _kind = CGPT.RestorePendingKind
    CGPT.RestorePendingGeneration = -1
    CGPT.RestorePendingKind = 0
    if _kind == 1 {
        _mood = CGPT.SelectMood
    }
    else {
        _mood = 'neutral'
    }
    CGPT.ApplyMood('restore',_mood)
}

OnCharacterGPTAffectIdleFallback
{
    _gen = TOINT(reference[0])
    if _gen != CGPT.IdleGeneration || CGPT.IdleActive != 1 {
        ''
        return
    }
    if CGPT.IdleExpectedGeneration != _gen {
        ''
        return
    }
    CGPT.IdleExpectedGeneration = -1
    CGPT.IdlePendingGeneration = _gen
    CGPT.IdlePendingKind = 2
    CGPT.PreserveBalloonScript("\![timerraise,100,1,OnCharacterGPTAffectIdleApply,%(_gen)]")
}

OnCharacterGPTAffectIdleApply
{
    _gen = TOINT(reference[0])
    if _gen != CGPT.IdleGeneration || CGPT.IdleActive != 1 {
        ''
        return
    }
    if CGPT.IdlePendingGeneration != _gen {
        ''
        return
    }
    if CGPT.IsPresentationBusy() {
        CGPT.PreserveBalloonScript("\![timerraise,400,1,OnCharacterGPTAffectIdleApply,%(_gen)]")
        return
    }
    _kind = CGPT.IdlePendingKind
    CGPT.IdlePendingGeneration = -1
    CGPT.IdlePendingKind = 0
    if _kind == 1 {
        _mood = CGPT.SelectMood
    }
    else {
        _mood = 'neutral'
    }
    CGPT.ApplyMood('idle',_mood)
}

OnCharacterGPTActivity
{
    _cancel = CGPT.CancelRestore
    "\C%(CGPT.ActivityScript)"
}

OnCharacterGPTReactionBegin
{
    CGPT.LinkedReactionHold = 1
    CGPT.IdleActive = 0
    _cancel = CGPT.CancelRestore
    "\C%(CGPT.ActivityScript)"
}

OnCharacterGPTRecentReactionGuardEnd
{
    CGPT.RecentReactionGuard = 0
    ''
}

OnCharacterGPTIdleReading
{
    _gen = TOINT(reference[0])
    if _gen != CGPT.IdleGeneration {
        ''
        return
    }
    if CGPT.IsPresentationBusy() {
        CGPT.PreserveBalloonScript("\![timerraise,1000,1,OnCharacterGPTIdleReading,%(_gen)]")
        return
    }
    CGPT.IdleActive = 1
    CGPT.IdleExpectedGeneration = _gen
    CGPT.IdlePendingGeneration = -1
    CGPT.IdlePendingKind = 0
    _cancel = CGPT.CancelRestore
    CGPT.PreserveBalloonScript("\![timerraise,650,1,OnCharacterGPTAffectIdleFallback,%(_gen)]\![send,websocket,ws://127.0.0.1:8766,QUERY|AFFECT|idle]")
}

OnCommunicate
{
    if CGPT.LinkedBusy == 1 {
        OnCharacterGPTLinkedBusyNotice
        return
    }
    "\0\s[3]中文對話由 CharacterGPT Runtime 處理。\n請左鍵點非觸摸區域開啟對話窗。\e"
}

OnOpenChat
{
    if CGPT.LinkedBusy == 1 {
        OnCharacterGPTLinkedBusyNotice
        return
    }
    CGPT.BustClickLatched = 0
    _activity = CGPT.ActivityScript
    "%(_activity)\![send,websocket,ws://127.0.0.1:8766,COMMAND|OPEN_CHAT]"
}

// Runtime websocket callback: Reference3 is already complete SakuraScript.
OnCharacterGPT
{
    reference[3]
}

OnConfigureAPIKey
{
    "\![open,passwordinput,OnCharacterGPTAPIKey,--timeout=-1,--limit=300]"
}
OnCharacterGPTAPIKey
{
    "\![send,websocket,ws://127.0.0.1:8766,CONFIG|APIKEY|%(reference[0])]"
}
OnCheckAPIKey
{
    "\![send,websocket,ws://127.0.0.1:8766,CONFIG|CHECKKEY]"
}
OnClearAPIKey
{
    "\![send,websocket,ws://127.0.0.1:8766,CONFIG|CLEARKEY]"
}
OnCharacterGPTAPIKeyStatus
{
    if reference[0] == 'configured' {
        OnCharacterGPTAPIKeyConfigured
        return
    }
    if reference[0] == 'missing' {
        OnCharacterGPTAPIKeyMissing
        return
    }
    if reference[0] == 'unavailable' {
        OnCharacterGPTAPIKeyUnavailable
        return
    }
    OnCharacterGPTAPIKeyError
}
OnCharacterGPTAPIKeyConfigured
{
    "\0\s[25]API Key 已設定。\n這只表示本機憑證已啟用；實際 API 驗證會在送出請求時進行。\e"
}
OnCharacterGPTAPIKeyMissing
{
    "\0\s[3]尚未設定 API Key。\n\q[現在設定,OnConfigureAPIKey]\n\q[稍後再說,OnCharacterGPTMenuClose]\e"
}
OnCharacterGPTAPIKeyUnavailable
{
    "\0\s[3]目前無法讀取 Bridge 的 API Key 狀態。\n可以稍候後從選單再次檢查。\e"
}
OnCharacterGPTAPIKeyError
{
    "\0\s[3]API Key 設定操作失敗。\n請稍候後再試一次。\e"
}

OnCharacterGPTNetworkUpdate
{
    CGPT.IdleActive = 0
    _idle = CGPT.ArmIdle
    _cancel = CGPT.CancelRestore
    "%(_idle)\![updatebymyself]"
}
OnUpdateBegin
{
    "\0\s[100]正在確認更新……"
}
OnUpdateReady
{
    _count = TOINT(reference[0]) + 1
    "\0\s[100]確認到%(_count)個更新檔案。\w5\n正在更新……"
}
OnUpdateComplete
{
    if reference[0] == 'none' {
        OnCharacterGPTUpdateNone
        return
    }
    "\0\s[25]\![set,balloontimeout,%(CGPT.BalloonTimeoutMs)]CharacterGPT 網路更新完成。\nSSP 結果：%(reference[0])\n更新檔案：%(reference[1])\e"
}
OnUpdateFailure
{
    "\0\s[3]\![set,balloontimeout,0]CharacterGPT 網路更新失敗。\n原因：%(reference[0])\n未完成檔案：%(reference[1])\e"
}
OnCharacterGPTUpdateNone
{
    "\0\s[25]\![set,balloontimeout,2200]目前已是最新版本。\e"
}
OnUpdateCheckComplete
{
    if reference[0] == 'none' {
        OnCharacterGPTUpdateNone
        return
    }
    "\0\s[25]\![set,balloontimeout,%(CGPT.BalloonTimeoutMs)]CharacterGPT 更新檢查完成。\nSSP 結果：%(reference[0])\e"
}
OnUpdateCheckFailure
{
    "\0\s[3]\![set,balloontimeout,0]CharacterGPT 更新檢查失敗。\n原因：%(reference[0])\e"
}

OnClose
{
    CGPT.IdleGeneration += 1
    CGPT.RestoreGeneration += 1
    _plug = ""
    if CGPT.ChatGPTLinkEnabled == 1 {
        _plug = "\![execute,http-post,http://127.0.0.1:8782/shutdown,--nodescript,--nofile=UTF-8,--timeout=1]"
    }
    "%(_plug)\![send,websocket,ws://127.0.0.1:8766,SYSTEM|CLOSE]\_w[120]\![close,websocket,ws://127.0.0.1:8766]\0\s[5]再見。\-\e"
}

// Linked-chat presentation adapter. Runtime owns lifecycle and affect; YAYA only renders.
CGPT.ExpressionSurface
{
    _x = _argv[0]
    if _x == 'smile' || _x == 'happy' || _x == 'positive' {
        25
        return
    }
    if _x == 'shy' || _x == 'embarrassed' {
        21
        return
    }
    if _x == 'wary' || _x == 'concerned' || _x == 'focused' {
        23
        return
    }
    if _x == 'annoyed' || _x == 'angry' {
        27
        return
    }
    if _x == 'sad' || _x == 'downcast' {
        4
        return
    }
    20
}

OnCharacterGPTLinkedPresence
{
    CGPT.LinkedBusy = 1
    CGPT.LinkedReactionHold = 0
    CGPT.IdleActive = 0
    _cancel = CGPT.CancelRestore
    _surface = CGPT.ExpressionSurface(reference[0])
    "\C\0\b[-1]\s[%(_surface)]\e"
}

OnCharacterGPTLinkedBridgeReaction
{
    CGPT.LinkedBusy = 1
    CGPT.LinkedReactionHold = 1
    CGPT.IdleActive = 0
    _cancel = CGPT.CancelRestore
    _surface = CGPT.ExpressionSurface(reference[1])
    "\![timerraise,2400,1,OnCharacterGPTLinkedReactionHoldEnd]\0\s[%(_surface)]\![set,balloontimeout,2200]%(reference[0])\e"
}
OnCharacterGPTLinkedReactionHoldEnd
{
    CGPT.LinkedReactionHold = 0
    ''
}
OnCharacterGPTLinkedThinking
{
    CGPT.LinkedBusy = 1
    CGPT.LinkedReactionHold = 0
    CGPT.IdleActive = 0
    _cancel = CGPT.CancelRestore
    _surface = CGPT.ExpressionSurface(reference[1])
    if reference[1] == '' { _surface = 23 }
    "\C\0\b[-1]\s[%(_surface)]\e"
}
OnCharacterGPTLinkedResponse
{
    CGPT.LinkedBusy = 1
    CGPT.LinkedReactionHold = 0
    CGPT.IdleActive = 0
    _cancel = CGPT.CancelRestore
    _surface = CGPT.ExpressionSurface(reference[0])
    "\C\0\b[-1]\s[%(_surface)]\e"
}
OnCharacterGPTLinkedResponseComplete
{
    CGPT.LinkedBusy = 0
    CGPT.LinkedReactionHold = 0
    _idle = CGPT.ArmIdle
    "%(_idle)\0\![set,balloontimeout,1800]整理好了。\e"
}
OnCharacterGPTLinkedRelease
{
    CGPT.LinkedBusy = 0
    CGPT.LinkedReactionHold = 0
    _idle = CGPT.ArmIdle
    "%(_idle)\0\b[-1]\e"
}
OnCharacterGPTLinkedBusy
{
    OnCharacterGPTLinkedBusyNotice
}
OnCharacterGPTLinkedBusyNotice
{
    "\0\s[3]\![set,balloontimeout,1800]現在正在處理 Web ChatGPT 的請求，請稍等一下。\e"
}

// Request lifecycle: Check never implies cancel.
OnCharacterGPTPendingCheck
{
    "\0\s[20]她還在思考中。\n\n\q[繼續等待,OnCharacterGPTPendingContinue,%(reference[0])]\n\q[打斷她,OnCharacterGPTPendingCancel,%(reference[0])]\e"
}
OnCharacterGPTPendingContinue
{
    "\![send,websocket,ws://127.0.0.1:8766,CONTROL|CONTINUE|%(reference[0])]\0\b[-1]\e"
}
OnCharacterGPTPendingCancel
{
    "\![send,websocket,ws://127.0.0.1:8766,CONTROL|CANCEL|%(reference[0])]\0\s[3]已送出中止要求。\![set,balloontimeout,1800]\e"
}

OnCharacterGPTAutonomousTick
{
    if ! CGPT.IsPresentationBusy() {
        "\C\![send,websocket,ws://127.0.0.1:8766,AUTONOMOUS|TICK]"
        return
    }
    "\C\![send,websocket,ws://127.0.0.1:8766,AUTONOMOUS|SKIP]"
}
OnCharacterGPTDeferred
{
    "\C\![send,websocket,ws://127.0.0.1:8766,DEFERRED|%(reference[0])]"
}

// Unicode round-trip acceptance probe. This is intentionally callable during migration.
OnCharacterGPTUnicodeProbe
{
    "\0\s[20]檢查並更新／說話／查詢／繁體中文\n日本語も正常です。\e"
}
