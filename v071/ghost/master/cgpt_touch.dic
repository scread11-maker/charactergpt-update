// CharacterGPT v0.7-alpha1-fix6 YAYA touch adapter.
// High-resolution MOVE remains local. YAYA never classifies gestures or affect.
// TouchProgress senses body state; Runtime owns authoritative present truth.

CGPT.TouchInit
{
    CGPT.TouchActive = 0
    CGPT.TouchMoving = 0
    CGPT.TouchRestingEmitted = 0
    CGPT.TouchTarget = ''
    CGPT.TouchCharacter = -1
    CGPT.TouchStage = 0
    CGPT.ContactBoundaryPending = 1
    CGPT.ContactEstablished = 0
    CGPT.ContactEstablishedTarget = ''
    CGPT.ContactEstablishedCharacter = -1
    CGPT.BustClickPending = 0
    CGPT.BustClickLatched = 0
    CGPT.BustLocalActive = 0
    CGPT.BookClickLatched = 0
    CGPT.BookLocalActive = 0
    CGPT.SingleMemoryPending = 0
}

CGPT.TouchRecognized
{
    _c = TOINT(_argv[0])
    _t = _argv[1]
    if _c == 0 && (_t == 'Head' || _t == 'Hair' || _t == 'Bust' || _t == 'Book') {
        1
        return
    }
    if _c == 1 && (_t == 'Head' || _t == 'Bust' || _t == 'Wing') {
        1
        return
    }
    0
}

CGPT.TouchControlHead
{
    if CGPT.HasBalloon() {
        '\C'
        return
    }
    ''
}

CGPT.TouchClickHead
{
    if CGPT.HasBalloon() {
        '\C\![set,balloontimeout,0]'
        return
    }
    ''
}

CGPT.TouchActivity
{
    // Book's local click/move latch must survive activity on the Book itself.
    // Other targets invalidate it, matching the frozen Satori behavior.
    _preserveBook = TOINT(_argv[0])
    CGPT.IdleActive = 0
    CGPT.IdleExpectedGeneration = -1
    CGPT.IdlePendingGeneration = -1
    if _preserveBook != 1 {
        CGPT.BookClickLatched = 0
        CGPT.BookLocalActive = 0
    }
    CGPT.ArmIdle
}

CGPT.TouchStart
{
    _c = TOINT(_argv[0])
    _t = _argv[1]
    _reason = _argv[2]
    _boundary = TOINT(_argv[3])

    CGPT.TouchActive = 1
    CGPT.TouchMoving = 1
    CGPT.TouchRestingEmitted = 0
    CGPT.TouchTarget = _t
    CGPT.TouchCharacter = _c
    CGPT.TouchStage = 5000
    CGPT.ContactEstablished = 0
    CGPT.ContactBoundaryPending = 0

    if _t == 'Bust' && _c == 0 {
        CGPT.BustLocalActive = 1
    }
    if _t == 'Book' && _c == 0 {
        CGPT.BookLocalActive = 1
    }

    _script = "\![execute,http-post,http://127.0.0.1:8769/touch/start,--nodescript,--nofile=UTF-8,--param=target=%(_t),--param=character_id=%(_c),--param=reason=%(_reason),--timeout=1]"
    _script += "\![timerraise,250,1,CharacterGPTTouchEstablishedTick,%(_c),%(_t)]"
    _script += "\![timerraise,900,1,CharacterGPTTouchStationaryTick,%(_c),%(_t)]"
    _script += "\![timerraise,5000,1,CharacterGPTTouchProgressTick,%(_c),%(_t),5000]"
    _script
}

CGPT.TouchReleaseScript
{
    _reason = _argv[0]
    _oldc = CGPT.TouchCharacter
    _oldt = CGPT.TouchTarget
    _linked = 1
    if CGPT.ContactEstablished == 1 && CGPT.ContactEstablishedTarget == _oldt && CGPT.ContactEstablishedCharacter == _oldc {
        if CGPT.RecentReactionGuard == 1 {
            _linked = 1
        }
        else {
            _linked = CGPT.LinkedBusy
        }
    }
    CGPT.TouchActive = 0
    CGPT.TouchMoving = 0
    CGPT.TouchRestingEmitted = 0
    CGPT.ContactBoundaryPending = 1
    CGPT.BustLocalActive = 0
    CGPT.BookLocalActive = 0
    "\![timerraise,250,1,CharacterGPTTouchEstablishedClearTick]\![execute,http-post,http://127.0.0.1:8769/touch/release,--nodescript,--nofile=UTF-8,--param=target=%(_oldt),--param=character_id=%(_oldc),--param=reason=%(_reason),--param=linked_busy=%(_linked),--timeout=1]"
}

CGPT.TouchImplicitBoundary
{
    _newc = TOINT(_argv[0])
    _newt = _argv[1]
    _oldc = CGPT.TouchCharacter
    _oldt = CGPT.TouchTarget
    _script = "\![execute,http-post,http://127.0.0.1:8769/touch/release,--nodescript,--nofile=UTF-8,--param=target=%(_oldt),--param=character_id=%(_oldc),--param=reason=implicit_target_change,--param=linked_busy=1,--timeout=1]"
    _script += CGPT.TouchStart(_newc,_newt,'implicit_target_change',1)
    _script
}

CGPT.TouchMoveScript
{
    _c = TOINT(_argv[0])
    _t = _argv[1]
    _x = _argv[2]
    _y = _argv[3]
    _r6 = _argv[4]
    _head = CGPT.TouchControlHead

    if CGPT.LinkedBusy == 1 {
        ''
        return
    }

    if _c == 0 && _t == 'Book' {
        _activity = CGPT.TouchActivity(1)
    }
    else {
        _activity = CGPT.TouchActivity(0)
    }
    _boundaryFlag = 0
    _script = _head + _activity

    if CGPT.ContactBoundaryPending == 1 {
        _script += CGPT.TouchStart(_c,_t,'reentry',1)
        _boundaryFlag = 1
    }
    elseif CGPT.TouchActive == 1 && (CGPT.TouchCharacter != _c || CGPT.TouchTarget != _t) {
        _script += CGPT.TouchImplicitBoundary(_c,_t)
        _boundaryFlag = 1
    }
    elseif CGPT.TouchActive != 1 {
        _script += CGPT.TouchStart(_c,_t,'first_move',0)
    }
    elseif CGPT.TouchMoving != 1 {
        CGPT.TouchMoving = 1
        CGPT.TouchRestingEmitted = 0
        _script += "\![execute,http-post,http://127.0.0.1:8769/touch/motion,--nodescript,--nofile=UTF-8,--param=target=%(_t),--timeout=1]"
    }

    CGPT.TouchMoving = 1
    CGPT.TouchRestingEmitted = 0
    _script += "\![timerraise,900,1,CharacterGPTTouchStationaryTick,%(_c),%(_t)]"

    if _boundaryFlag == 1 {
        _script += "\![send,websocket,ws://127.0.0.1:8766,MOVE|%(_c)|%(_t)|%(_x)|%(_y)|%(_r6)|boundary=1]"
    }
    else {
        _script += "\![send,websocket,ws://127.0.0.1:8766,MOVE|%(_c)|%(_t)|%(_x)|%(_y)|%(_r6)]"
    }

    // Local presentation reflexes are presentation-only, never semantic classification.
    if _c == 0 && _t == 'Bust' && CGPT.BustLocalActive != 1 {
        CGPT.BustLocalActive = 1
        if ! CGPT.HasBalloon() {
            _script += '\0\s[2]'
        }
    }
    if _c == 0 && _t == 'Book' && CGPT.BookLocalActive != 1 {
        CGPT.BookLocalActive = 1
        if ! CGPT.HasBalloon() {
            _script += '\0\s[0]'
        }
    }
    _script
}

OnMouseMove
{
    _c = TOINT(reference[3])
    _t = reference[4]
    if ! CGPT.TouchRecognized(_c,_t) {
        ''
        return
    }
    CGPT.TouchMoveScript(_c,_t,reference[0],reference[1],reference[6])
}

OnMouseClick
{
    if TOINT(reference[5]) != 0 {
        ''
        return
    }
    _c = TOINT(reference[3])
    _t = reference[4]
    if ! CGPT.TouchRecognized(_c,_t) {
        if _c == 1 {
            OnOpenChat
            return
        }
        OnCharacterGPTMenu
        return
    }
    if CGPT.LinkedBusy == 1 {
        ''
        return
    }
    if _c == 0 && _t == 'Bust' {
        CGPT.BustClickPending = 1
        CGPT.BustClickCharacter = _c
        CGPT.BustClickPart = _t
        CGPT.BustClickX = reference[0]
        CGPT.BustClickY = reference[1]
        CGPT.BustLocalActive = 1
        CGPT.BustClickLatched = 1
        CGPT.BookClickLatched = 0
        _activity = CGPT.TouchActivity(0)
        "%(_activity)\0\s[22]\![timerraise,600,1,CharacterGPTBustSingleCommit]"
        return
    }
    if _c == 0 && _t == 'Book' {
        CGPT.BustClickLatched = 0
        CGPT.BookLocalActive = 1
        CGPT.BookClickLatched = 1
        _activity = CGPT.TouchActivity(1)
        _head = CGPT.TouchClickHead
        "%(_head)%(_activity)\0\s[0]\![send,websocket,ws://127.0.0.1:8766,POINTER|single|%(_c)|%(_t)|%(reference[0])|%(reference[1])]\![timerraise,1000,1,CharacterGPTBookLocalRelease]"
        return
    }

    CGPT.BustClickLatched = 0
    CGPT.BookClickLatched = 0
    CGPT.SingleMemoryPending = 1
    CGPT.SingleMemoryCharacter = _c
    CGPT.SingleMemoryTarget = _t
    _activity = CGPT.TouchActivity(0)
    _head = CGPT.TouchClickHead
    "%(_head)%(_activity)\![send,websocket,ws://127.0.0.1:8766,POINTER|single|%(_c)|%(_t)|%(reference[0])|%(reference[1])]\![timerraise,600,1,CharacterGPTSingleMemoryCommit]"
}

CharacterGPTSingleMemoryCommit
{
    if CGPT.SingleMemoryPending != 1 {
        ''
        return
    }
    CGPT.SingleMemoryPending = 0
    "\C\![execute,http-post,http://127.0.0.1:8769/touch/memory,--nodescript,--nofile=UTF-8,--param=target=%(CGPT.SingleMemoryTarget),--param=character_id=%(CGPT.SingleMemoryCharacter),--param=state=light_touch,--timeout=1]"
}

CharacterGPTBustSingleCommit
{
    if CGPT.BustClickPending != 1 || CGPT.LinkedBusy == 1 {
        ''
        return
    }
    CGPT.BustClickPending = 0
    _head = CGPT.TouchClickHead
    "%(_head)\![send,websocket,ws://127.0.0.1:8766,POINTER|single|%(CGPT.BustClickCharacter)|%(CGPT.BustClickPart)|%(CGPT.BustClickX)|%(CGPT.BustClickY)]\![execute,http-post,http://127.0.0.1:8769/touch/memory,--nodescript,--nofile=UTF-8,--param=target=%(CGPT.BustClickPart),--param=character_id=%(CGPT.BustClickCharacter),--param=state=light_touch,--timeout=1]"
}

CharacterGPTBookLocalRelease
{
    // The one-second timer only releases the click latch. If the pointer has
    // already left the Book, local-active is zero and affect-aware restore may
    // run. If it is still over the Book, keep surface 0.
    CGPT.BookClickLatched = 0
    if CGPT.BookLocalActive != 1 && CGPT.IdleActive != 1 && ! CGPT.IsPresentationBusy() {
        CGPT.RestoreGeneration += 1
        "\C\![timerraise,0,1,OnCharacterGPTSurfaceRestore,%(CGPT.RestoreGeneration)]"
        return
    }
    ''
}

OnMouseDoubleClick
{
    if TOINT(reference[5]) != 0 {
        ''
        return
    }
    _c = TOINT(reference[3])
    _t = reference[4]
    if ! CGPT.TouchRecognized(_c,_t) {
        ''
        return
    }
    if CGPT.LinkedBusy == 1 {
        ''
        return
    }

    if CGPT.SingleMemoryPending == 1 && CGPT.SingleMemoryCharacter == _c && CGPT.SingleMemoryTarget == _t {
        CGPT.SingleMemoryPending = 0
    }
    CGPT.BustClickPending = 0
    CGPT.BustClickLatched = 0
    CGPT.BookClickLatched = 0
    CGPT.BookLocalActive = 0
    _activity = CGPT.TouchActivity(0)
    _head = CGPT.TouchClickHead

    if _c == 0 && _t == 'Bust' {
        CGPT.BustLocalActive = 1
        CGPT.BustClickLatched = 1
        "%(_head)%(_activity)\0\s[22]\![send,websocket,ws://127.0.0.1:8766,POINTER|double|%(_c)|%(_t)|%(reference[0])|%(reference[1])]\![execute,http-post,http://127.0.0.1:8769/touch/memory,--nodescript,--nofile=UTF-8,--param=target=%(_t),--param=character_id=%(_c),--param=state=grab,--timeout=1]"
        return
    }
    "%(_head)%(_activity)\![send,websocket,ws://127.0.0.1:8766,POINTER|double|%(_c)|%(_t)|%(reference[0])|%(reference[1])]\![execute,http-post,http://127.0.0.1:8769/touch/memory,--nodescript,--nofile=UTF-8,--param=target=%(_t),--param=character_id=%(_c),--param=state=double,--timeout=1]"
}

OnMouseHover
{
    _c = TOINT(reference[3])
    _t = reference[4]
    if CGPT.TouchActive == 1 && CGPT.TouchMoving == 1 && CGPT.TouchCharacter == _c && CGPT.TouchTarget == _t {
        CGPT.TouchMoving = 0
        _head = CGPT.TouchControlHead
        "%(_head)\![execute,http-post,http://127.0.0.1:8769/touch/stationary,--nodescript,--nofile=UTF-8,--param=target=%(_t),--timeout=1]\![timerraise,2500,1,CharacterGPTTouchRestingTick,%(_c),%(_t)]"
        return
    }
    ''
}

CharacterGPTTouchEstablishedTick
{
    _c = TOINT(reference[0])
    _t = reference[1]
    if CGPT.TouchActive == 1 && CGPT.TouchCharacter == _c && CGPT.TouchTarget == _t {
        CGPT.ContactEstablished = 1
        CGPT.ContactEstablishedTarget = _t
        CGPT.ContactEstablishedCharacter = _c
    }
    ''
}

CharacterGPTTouchEstablishedClearTick
{
    if CGPT.TouchActive != 1 {
        CGPT.ContactEstablished = 0
    }
    ''
}

CharacterGPTTouchStationaryTick
{
    _c = TOINT(reference[0])
    _t = reference[1]
    if CGPT.TouchActive != 1 || CGPT.TouchMoving != 1 || CGPT.TouchCharacter != _c || CGPT.TouchTarget != _t {
        ''
        return
    }
    CGPT.TouchMoving = 0
    _head = CGPT.TouchControlHead
    "%(_head)\![execute,http-post,http://127.0.0.1:8769/touch/stationary,--nodescript,--nofile=UTF-8,--param=target=%(_t),--timeout=1]\![timerraise,2100,1,CharacterGPTTouchRestingTick,%(_c),%(_t)]"
}

CharacterGPTTouchRestingTick
{
    _c = TOINT(reference[0])
    _t = reference[1]
    if CGPT.TouchActive != 1 || CGPT.TouchMoving != 0 || CGPT.TouchRestingEmitted == 1 || CGPT.TouchCharacter != _c || CGPT.TouchTarget != _t {
        ''
        return
    }
    CGPT.TouchRestingEmitted = 1
    _head = CGPT.TouchControlHead
    "%(_head)\![execute,http-post,http://127.0.0.1:8769/touch/resting,--nodescript,--nofile=UTF-8,--param=target=%(_t),--timeout=2]"
}

CharacterGPTTouchProgressTick
{
    _c = TOINT(reference[0])
    _t = reference[1]
    _stage = TOINT(reference[2])
    if CGPT.TouchActive != 1 || CGPT.TouchCharacter != _c || CGPT.TouchTarget != _t || CGPT.TouchStage != _stage {
        ''
        return
    }
    _head = CGPT.TouchControlHead
    _script = "%(_head)\![execute,http-post,http://127.0.0.1:8769/touch/progress,--nodescript,--nofile=UTF-8,--param=target=%(_t),--param=duration_ms=%(_stage),--timeout=2]"
    if _stage == 5000 {
        CGPT.TouchStage = 10000
        _script += "\![timerraise,5000,1,CharacterGPTTouchProgressTick,%(_c),%(_t),10000]"
    }
    elseif _stage == 10000 {
        CGPT.TouchStage = 15000
        _script += "\![timerraise,5000,1,CharacterGPTTouchProgressTick,%(_c),%(_t),15000]"
    }
    else {
        CGPT.TouchStage = 0
    }
    _script
}

CGPT.LeaveCommon
{
    _reason = _argv[0]
    _restore = TOINT(_argv[1])
    if CGPT.TouchActive != 1 {
        ''
        return
    }
    _head = CGPT.TouchControlHead
    _script = _head + CGPT.TouchReleaseScript(_reason)
    if _restore == 1 && ! CGPT.IsPresentationBusy() && CGPT.BustClickLatched != 1 && CGPT.BookClickLatched != 1 && CGPT.IdleActive != 1 {
        CGPT.RestoreGeneration += 1
        _script += "\![timerraise,0,1,OnCharacterGPTSurfaceRestore,%(CGPT.RestoreGeneration)]"
    }
    _script
}

OnMouseLeave
{
    _c = TOINT(reference[3])
    _t = reference[4]
    if ! CGPT.TouchRecognized(_c,_t) {
        ''
        return
    }

    _matchesActive = 0
    if CGPT.TouchActive == 1 && CGPT.TouchCharacter == _c && CGPT.TouchTarget == _t {
        _matchesActive = 1
    }

    // Local click state must clear even when this interaction never emitted MOVE.
    if _c == 0 && _t == 'Bust' {
        CGPT.BustLocalActive = 0
    }
    if _c == 0 && _t == 'Book' {
        CGPT.BookLocalActive = 0
    }

    if _matchesActive == 1 {
        _restore = 1
        if _c == 0 && _t == 'Bust' && CGPT.BustClickLatched == 1 {
            _restore = 0
        }
        if _c == 0 && _t == 'Book' && (CGPT.BookClickLatched == 1 || CGPT.IdleActive == 1) {
            _restore = 0
        }
        CGPT.LeaveCommon('mouse_leave',_restore)
        return
    }

    // A click-only leave closes the local boundary, but never releases a
    // different active target (stronger than the legacy global helper state).
    if CGPT.TouchActive != 1 {
        CGPT.ContactBoundaryPending = 1
    }
    if CGPT.LinkedBusy == 1 {
        ''
        return
    }
    if _c == 0 && _t == 'Bust' && CGPT.BustClickLatched == 1 {
        ''
        return
    }
    if _c == 0 && _t == 'Book' && (CGPT.BookClickLatched == 1 || CGPT.IdleActive == 1) {
        ''
        return
    }
    if CGPT.TouchActive != 1 && ! CGPT.IsPresentationBusy() {
        CGPT.RestoreGeneration += 1
        "\C\![timerraise,0,1,OnCharacterGPTSurfaceRestore,%(CGPT.RestoreGeneration)]"
        return
    }
    ''
}

OnMouseLeaveAll
{
    _hadActive = CGPT.TouchActive
    CGPT.BustLocalActive = 0
    CGPT.BookLocalActive = 0

    if _hadActive == 1 {
        _restore = 1
        if CGPT.BustClickLatched == 1 || CGPT.BookClickLatched == 1 || CGPT.IdleActive == 1 {
            _restore = 0
        }
        CGPT.LeaveCommon('mouse_leave_all',_restore)
        return
    }

    CGPT.ContactBoundaryPending = 1
    if CGPT.LinkedBusy == 1 || CGPT.BustClickLatched == 1 || CGPT.BookClickLatched == 1 || CGPT.IdleActive == 1 {
        ''
        return
    }
    if ! CGPT.IsPresentationBusy() {
        CGPT.RestoreGeneration += 1
        "\C\![timerraise,0,1,OnCharacterGPTSurfaceRestore,%(CGPT.RestoreGeneration)]"
        return
    }
    ''
}
